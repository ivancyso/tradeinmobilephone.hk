---
import Base from '../../layouts/Base.astro';
import PriceList from '../../components/PriceList.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import Steps from '../../components/Steps.astro';
import site from '../../data/site.json';
import { categories, updatedAt, formatDateZh, fmt, maxPrice, modelUrl, type Category } from '../../lib/prices';
import { categoryCopy } from '../../lib/copy';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: Category };
const copy = categoryCopy[cat.slug];
const year = updatedAt.slice(0, 4);
const title = `${copy.title.replace('{year}', year)}`;
const priced = cat.models.filter((m) => maxPrice(m) != null);
const description = `${copy.h1}（${formatDateZh(updatedAt)}更新）。${priced.slice(0, 3).map((m) => `${m.name} 最高 ${fmt(maxPrice(m))}`).join('，')}${priced.length ? '。' : ''}${copy.intro}`.slice(0, 160);
const crumbs = [{ name: '首頁', href: '/' }, { name: cat.label, href: `/${cat.slug}/` }];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${site.url}${c.href}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${copy.h1} ${year}`,
    itemListElement: cat.models.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: `${m.name} 回收價`, url: `${site.url}${modelUrl(cat.slug, m)}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1 style="margin-top:14px">{copy.h1} {year}</h1>
    <p class="muted">價格更新：{formatDateZh(updatedAt)}</p>
    <p>{copy.intro}</p>
    {priced.length > 0 && (
      <div class="answer-box">
        <p><strong>最高回收參考價：</strong>{priced.slice(0, 5).map((m) => `${m.name} ${fmt(maxPrice(m))}`).join('；')}。</p>
      </div>
    )}
    <PriceList cat={cat.slug} models={cat.models} headingLevel="h2" />
    <p class="small muted" style="margin-top:12px">價格以港幣計，只供參考，最終以驗機結果為準。</p>

    <h2>如何出售你的{cat.name}？</h2>
    <Steps />

    <h2>{cat.name} 回收常見問題</h2>
    <Faq faqs={copy.faqs} />

    <h2>其他回收價格表</h2>
    <div class="chips" style="margin-bottom:20px">
      {categories.filter((c) => c.slug !== cat.slug).map((c) => <a class="tab" href={`/${c.slug}/`}>{c.label}</a>)}
    </div>
  </div>
</Base>
