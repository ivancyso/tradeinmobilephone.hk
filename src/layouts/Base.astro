---
import '../styles/global.css';
import site from '../data/site.json';
import { categories } from '../lib/prices';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  ctaHref?: string;
}
const { title, description, jsonLd = [], ogType = 'website', ctaHref = '/contact/' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const nav = [
  ...categories.map((c) => ({ href: `/${c.slug}/`, label: c.name })),
  { href: '/guides/', label: '回收指南' },
  { href: '/process/', label: '回收流程' },
];
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#org`,
  name: site.name,
  url: site.url,
  email: site.email,
  areaServed: { '@type': 'City', name: 'Hong Kong' },
};
const webLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  inLanguage: 'zh-HK',
  publisher: { '@id': `${site.url}/#org` },
};
---
<!doctype html>
<html lang="zh-HK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-HK" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/json" href="/prices.json" title="回收價格數據" />
    <meta name="theme-color" content="#0b8a5a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_HK" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify([orgLd, webLd, ...jsonLd])} />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href="/" aria-label={`${site.name} 首頁`}><span class="logo-mark">$</span>{site.shortName}</a>
        <nav class="nav" aria-label="主選單">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="cta" href="/contact/">即時報價</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="cols">
          <div>
            <h3>{site.name}</h3>
            <p>{site.description}</p>
            <p>電郵：<a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          {categories.map((c) => (
            <div>
              <h3><a href={`/${c.slug}/`}>{c.label}</a></h3>
              <ul>
                {c.models.slice(0, 6).map((m) => <li><a href={`/${c.slug}/${m.slug}/`}>{m.name} 回收價</a></li>)}
              </ul>
            </div>
          ))}
          <div>
            <h3>資訊</h3>
            <ul>
              <li><a href="/guides/">回收指南</a></li>
              <li><a href="/process/">回收流程</a></li>
              <li><a href="/contact/">聯絡及報價</a></li>
              <li><a href="/prices.json">價格數據 (JSON)</a></li>
            </ul>
          </div>
        </div>
        <p class="legal">網站所列回收價只供參考，最終價格以驗機結果為準。Apple、iPhone、iPad、MacBook 為 Apple Inc. 的商標；Samsung、Galaxy 為 Samsung Electronics 的商標。本網站與上述公司並無關連。© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>
    <div class="mobile-cta"><a class="btn btn-primary" href={ctaHref}>免費即時報價</a></div>
  </body>
</html>
