---
interface Props { faqs: { q: string; a: string }[]; open?: boolean }
const { faqs, open = false } = Astro.props;
---
<div class="faq card pad">
  {faqs.map((f, i) => (
    <details open={open && i === 0}>
      <summary>{f.q}</summary>
      <div class="answer" set:html={f.a} />
    </details>
  ))}
</div>
