---
const steps = [
  { t: '網上查價', d: '在本網站搜尋型號及容量，即時看到最新參考回收價。' },
  { t: '提交資料', d: '透過報價表格提供型號、容量、成色及電池健康度，我們會盡快回覆確認價。' },
  { t: '約定交收', d: '揀選方便你的港鐵站或地點及時間，即場驗機約 5 至 10 分鐘。' },
  { t: '即時收款', d: '驗機無誤即場付款（現金或 FPS 轉數快），你接受報價先成交。' },
];
---
<ol class="steps">
  {steps.map((s) => <li class="card"><h3>{s.t}</h3><p>{s.d}</p></li>)}
</ol>
